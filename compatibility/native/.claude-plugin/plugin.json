{
  "name": "bridge-claude-codex",
  "version": "1.1.0",
  "description": "Asynchronous two-way messaging between Claude Code and Codex conversations.",
  "author": {
    "name": "KeeVeeG",
    "url": "https://github.com/KeeVeeG"
  },
  "homepage": "https://github.com/KeeVeeG/claude-codex-bridge",
  "repository": "https://github.com/KeeVeeG/claude-codex-bridge",
  "license": "MIT",
  "keywords": [
    "desktop",
    "terminal",
    "messaging",
    "windows",
    "macos",
    "mcp"
  ],
  "skills": "./skills/",
  "mcpServers": {
    "bridge-claude-codex": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/mcp.mjs",
        "--plugin-version=1.1.0"
      ],
      "env": {
        "CLAUDE_CODE_MESSAGING_SOCKET": "${CLAUDE_CODE_MESSAGING_SOCKET:-}",
        "CLAUDE_CONFIG_DIR": "${CLAUDE_CONFIG_DIR:-}",
        "CLAUDE_CODEX_BRIDGE_STATE_DIR": "${CLAUDE_CODEX_BRIDGE_STATE_DIR:-}",
        "CLAUDE_CODEX_BRIDGE_REGISTRY_DIR": "${CLAUDE_CODEX_BRIDGE_REGISTRY_DIR:-}",
        "CLAUDE_CODEX_BRIDGE_CODEX_BIN": "${CLAUDE_CODEX_BRIDGE_CODEX_BIN:-}",
        "CLAUDE_CODEX_BRIDGE_DAEMON": "${CLAUDE_CODEX_BRIDGE_DAEMON:-}",
        "CODEX_HOME": "${CODEX_HOME:-}",
        "CLAUDE_CODEX_BRIDGE_SSH_HOST": "${CLAUDE_CODEX_BRIDGE_SSH_HOST:-}"
      }
    }
  }
}
