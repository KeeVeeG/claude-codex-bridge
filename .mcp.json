{
  "mcpServers": {
    "bridge-claude-codex": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/mcp.mjs"
      ],
      "env_vars": [
        "CODEX_APP_TOOLS_PIPE_PATH",
        "CODEX_THREAD_ID",
        "CLAUDE_CODE_MESSAGING_SOCKET",
        "LOCALAPPDATA",
        "USERPROFILE",
        "HOME",
        "PATH",
        "CLAUDE_CONFIG_DIR",
        "CLAUDE_CODEX_BRIDGE_STATE_DIR",
        "CLAUDE_CODEX_BRIDGE_REGISTRY_DIR",
        "CLAUDE_CODEX_BRIDGE_CODEX_BIN",
        "CLAUDE_CODEX_BRIDGE_DAEMON",
        "CODEX_HOME",
        "CLAUDE_CODEX_BRIDGE_SSH_HOST"
      ]
    }
  }
}
